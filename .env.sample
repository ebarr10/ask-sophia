# Slack Bot Configuration
# Get these from https://api.slack.com/apps -> Your App -> OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack App Token (for Socket Mode)
# Get this from https://api.slack.com/apps -> Your App -> Basic Information -> App-Level Tokens
# Should start with xapp-
SLACK_APP_TOKEN=xapp-your-app-token-here

# Gemini API Configuration
# Get your API key from https://makersuite.google.com/app/apikey or https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Gemini Model Configuration
# Options: gemini-pro, gemini-pro-vision, gemini-1.5-pro, etc.
GEMINI_MODEL=gemini-pro
